{
  "name": "@catalog/api",
  "private": true,
  "nx": { "name": "api", "projectType": "application", "tags": ["scope:backend", "type:app"] },
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "serve": "tsc -p tsconfig.json && node dist/main.js",
    "openapi": "tsc -p tsconfig.json && node dist/openapi.js"
  },
  "dependencies": {
    "@catalog/consolidation": "workspace:*",
    "@catalog/domain": "workspace:*",
    "@catalog/persistence": "workspace:*",
    "@catalog/reviews": "workspace:*",
    "@catalog/rules": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
