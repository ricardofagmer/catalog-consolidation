{
  "name": "catalog-workspace",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "cli": "node apps/cli/dist/main.js",
    "parity": "scripts/parity-check.sh",
    "dev": "nx run-many -t serve dev --parallel=2",
    "start:all": "CATALOG_DB_PATH=\"${CATALOG_DB_PATH:-$PWD/out/dev/catalog.db}\" API_BASE_URL=\"${API_BASE_URL:-http://127.0.0.1:3001}\" nx run-many -t serve dev --parallel=2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nx/eslint-plugin": "23.2.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "nx": "23.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
