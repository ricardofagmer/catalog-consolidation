{
  "cwd": "a scratch directory holding data/catalog.db and data/ProductEntry.json copies",
  "normalizations": [
    "run id on the first stdout line of consolidate -> <run>",
    "migrate backup path timestamp -> <timestamp>",
    "program name in help and usage lines -> <prog>",
    "JSON log lines: timestamp, correlationId, durationMs -> placeholders; key order kept",
    "correlationId=<hex> in messages -> correlationId=<id>",
    "absolute scratch directory -> <work>",
    "table dumps omit CreatedAt"
  ],
  "scenarios": [
    {
      "name": "migrate",
      "description": "migrate a fresh copy: stdout (backup path normalized), one valid backup, SchemaVersion rows, backfilled keys",
      "commands": [
        {
          "step": "01-migrate",
          "args": "migrate --db data/catalog.db",
          "exit": 0
        }
      ]
    },
    {
      "name": "migrate-up-to-date",
      "description": "migrate an already migrated copy again",
      "commands": [
        {
          "step": "01-migrate-again",
          "args": "migrate --db data/catalog.db",
          "exit": 0
        }
      ]
    },
    {
      "name": "consolidate-first",
      "description": "first consolidation: stdout, JSONL report, tables without CreatedAt (976/255/2)",
      "commands": [
        {
          "step": "01-consolidate",
          "args": "consolidate --db data/catalog.db --input data/ProductEntry.json --report reports/first.jsonl",
          "exit": 0
        }
      ]
    },
    {
      "name": "consolidate-rerun",
      "description": "idempotent re-run: rows_written=0, tables unchanged",
