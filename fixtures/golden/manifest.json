        {
          "step": "01-migrate",
          "args": "migrate --db data/catalog.db",
          "exit": 0
        },
        {
          "step": "02-consolidate-dry-run",
          "args": "consolidate --db data/catalog.db --input data/ProductEntry.json --dry-run --report reports/dry.jsonl",
          "exit": 0
        }
      ]
    },
    {
